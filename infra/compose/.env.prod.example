# Copy to infra/compose/.env.prod and edit before `docker compose ... up`.
# Every value marked CHANGE ME must be replaced for a real deployment.

DOMAIN=scan.example.com
ACME_EMAIL=security@example.com
API_BASE=https://scan.example.com
WEB_BASE=https://scan.example.com
CORS_ORIGINS=https://scan.example.com
# Only used by the optional `venomscan_api.seed` demo; the compose default is
# http://api:8000/demo so a Docker trial can scan its own fixture.
SEED_TARGET_URL=http://api:8000/demo
# Intentionally vulnerable fixtures and interactive API docs stay off in production.
DEMO_ENABLED=false

# openssl rand -hex 32
SECRET_KEY=CHANGE-ME-64-hex-characters
POSTGRES_USER=venom
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=venomscan

# Keep false for internet-facing targets. Only local labs may set true.
ALLOW_PRIVATE_TARGETS=false
SCAN_DEFAULT_PROFILE=safe
SCAN_MAX_REQUESTS=120
SCAN_MAX_SECONDS=90
SCAN_RPS=4
SCAN_OSINT_ENABLED=true
# Wayback/urlscan archive listing (passive; URLs are listed, never fetched).
SCAN_HISTORY_ENABLED=true
# Optional read-only exposure intel; blank disables the provider.
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
# AlienVault OTX passive subdomain intel (keyless sources are used when blank).
OTX_API_KEY=
# Headless Chromium capture of SPA routes and XHR calls (Playwright is in the image).
SCAN_SPA_ENABLED=false
SCAN_DIRS_ENABLED=true

# Out-of-band listener for SSRF/XXE. On a VPS use the public hostname.
OOB_ENABLED=true
OOB_BIND_PORT=0
OOB_PUBLIC_BASE_URL=

# Optional LLM. Leave LLM_API_KEY empty for deterministic analysis only.
LLM_PROVIDER=openai_compat
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# AI analysis cache and automatic triage/report autofill. With no LLM key the
# deterministic fallback still runs.
AI_CACHE_TTL_SECONDS=900
AI_AUTO_TRIAGE=true
AI_REPORT_AUTOFILL=true

# Signed report links stay valid for this many hours.
REPORT_LINK_HOURS=168

# Optional operator egress proxy (http/https only).
UPSTREAM_PROXY_URL=

# Optional Nuclei. Put the Linux binary at NUCLEI_BIN_DIR/nuclei (see
# docs/OPERATOR_GUIDE.md); it is mounted read-only at /opt/nuclei in api + worker
# and only runs for `active` scans with explicit consent.
NUCLEI_ENABLED=true
NUCLEI_BINARY=/opt/nuclei/nuclei
NUCLEI_TEMPLATES=/nuclei-templates
NUCLEI_SEVERITIES=info,low,medium
NUCLEI_RATE_LIMIT=10
NUCLEI_TIMEOUT=60

# Host paths mounted into api + worker (relative to the compose file).
PLUGIN_DIRS=/plugins
PLUGIN_DIRS_HOST=../../examples/plugins
NUCLEI_TEMPLATES_HOST=../../nuclei-templates
NUCLEI_BIN_DIR=../../.nuclei-bin
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
# `redis` shares lockout state across API workers (Redis is part of this stack);
# `memory` keeps it per process and is only correct for a single API worker.
LOGIN_STATE_BACKEND=redis
# Public sign-up is off by default. To create the first accounts, set true, register
# them, then set false and restart api (`docker compose ... up -d api`).
ALLOW_REGISTRATION=false
# Caddy on the internal Docker network is trusted automatically. List extra proxy
# addresses here only if a proxy outside that network forwards client requests.
TRUSTED_PROXIES=
# Cloud AI destinations must be HTTPS and appear in this allowlist.
AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
