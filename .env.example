# ── Core ────────────────────────────────────────────────────────────────
ENV=dev
SECRET_KEY=dev-only-change-me-32-bytes-minimum-0000
API_BASE=http://127.0.0.1:8000
# Override the demo target created by `python -m venomscan_api.seed` (defaults to API_BASE/demo).
# SEED_TARGET_URL=http://127.0.0.1:8000/demo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=480

# ── Datastores ──────────────────────────────────────────────────────────
# pg8000 is pure Python (works under Windows Application Control policies).
# Use postgresql+psycopg for Linux/Docker deployments with libpq.
DATABASE_URL=postgresql+pg8000://venom:venom@127.0.0.1:55432/venomscan
REDIS_URL=redis://127.0.0.1:56379/0

# inline = run scans in a local background thread (no Redis/Celery needed)
# celery = dispatch to Celery workers
TASK_MODE=inline

# ── Scanner safety ──────────────────────────────────────────────────────
# Only enable for local lab targets (127.0.0.1 / private ranges).
ALLOW_PRIVATE_TARGETS=false
SCAN_DEFAULT_PROFILE=safe
SCAN_MAX_REQUESTS=120
SCAN_MAX_SECONDS=90
SCAN_RPS=4
# Enables crt.sh/Cert Spotter subdomain discovery and IANA RDAP registration lookups.
# These are metadata lookups to third parties; no target traffic leaves the scope.
SCAN_OSINT_ENABLED=true
# Wayback CDX + urlscan.io archive listing. URLs are listed, never fetched.
SCAN_HISTORY_ENABLED=true
# Optional read-only internet-exposure intel. Leave blank to skip both providers.
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
# AlienVault OTX passive DNS. Anonymous access now returns HTTP 429, so the
# source is skipped unless a free OTX key is configured.
OTX_API_KEY=
# Renders the target once in headless Chromium to capture client-side routes and
# XHR calls. Out-of-scope and non-GET browser requests are aborted. Requires the
# Playwright Chromium build; scans degrade with a warning when it is missing.
SCAN_SPA_ENABLED=false
SCAN_DIRS_ENABLED=true
# Out-of-band listener for the SSRF and XXE checks. Loopback bind is safe for local
# labs; for remote targets bind 0.0.0.0 and set OOB_PUBLIC_BASE_URL to a host the
# target can reach. Scans without a listener skip both checks with a warning.
# A fixed port or public base URL keeps the callback payload stable, so repeated
# scans merge into one finding instead of one row per restart.
OOB_ENABLED=true
OOB_BIND_HOST=127.0.0.1
OOB_BIND_PORT=0
OOB_PUBLIC_BASE_URL=

# ── AI (optional) ───────────────────────────────────────────────────────
# Leave LLM_API_KEY empty to run deterministic analysis only. The same values can be
# set per workspace in Settings → AI intelligence; the key stored there is Fernet-encrypted.
LLM_PROVIDER=openai_compat
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Per-attempt timeout (seconds), retries for transport/408/429/5xx, and how long a
# successful provider analysis is reused for the same evidence (0 disables the cache).
LLM_TIMEOUT=30
LLM_RETRIES=1
AI_CACHE_TTL_SECONDS=900
# Generate summary + next_steps (plus an analyst note for the top findings) when a
# report is created, so every report carries an AI section. Set to false to keep
# report generation free of provider calls.
AI_REPORT_AUTOFILL=true

# ── Reports ─────────────────────────────────────────────────────────────
# Lifetime of HMAC-signed report links (hours). Rotating SECRET_KEY revokes them all.
REPORT_LINK_HOURS=168

# ── Integrations (all optional) ─────────────────────────────────────────
# Operator egress proxy for target traffic (http/https only). Scope + SSRF checks
# still run on every request and redirect.
UPSTREAM_PROXY_URL=

# Nuclei runs only during active scans and only when enabled here. The binary must be
# an absolute path to an executable file; templates must be an absolute directory
# (the repo ships a reviewed starter set in ./nuclei-templates).
NUCLEI_ENABLED=false
NUCLEI_BINARY=
NUCLEI_TEMPLATES=
NUCLEI_SEVERITIES=info,low,medium
NUCLEI_RATE_LIMIT=10
NUCLEI_TIMEOUT=60

# Comma-separated directories scanned for analysis-only plugins (see docs/PLUGIN_AUTHORING.md).
# Discovery is AST-only; execution is an isolated subprocess with a scoped payload.
PLUGIN_DIRS=

# ── Celery worker limits (TASK_MODE=celery) ─────────────────────────────
TASK_SOFT_TIME_LIMIT=540
TASK_TIME_LIMIT=600
WORKER_MAX_TASKS_PER_CHILD=50
WORKER_MAX_MEMORY_KB=600000
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
# `memory` is correct for one API process; set `redis` (with REDIS_URL) when
# several API workers serve logins so every worker sees the same counters.
LOGIN_STATE_BACKEND=memory
# Public sign-up. Close it on internet-facing installs once the team has accounts.
ALLOW_REGISTRATION=true
